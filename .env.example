APP_ENV=prod
# Local UI port for both `make prod` and the default local smoke helpers.
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=1209600
CORS_ALLOW_ORIGINS=https://fleetflow.example.com
DEV_SEED_DEMO_DATA=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
BOOTSTRAP_RATE_LIMIT_ATTEMPTS=3
BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=3600
POSTGRES_DB=fleetflow
POSTGRES_USER=fleetflow
POSTGRES_IMAGE=postgres:16
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql://fleetflow:replace-with-a-strong-db-password@postgres:5432/fleetflow
NOTIFICATION_TIMEOUT_SECONDS=5
NETFLEET_API_KEY=
NETFLEET_BASE_URL=https://api.netfleet.bg:8080
NETFLEET_TIMEOUT_SECONDS=5
LOG_FORMAT=auto
RESTORE_DRILL_MAX_AGE_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USE_TLS=true
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
